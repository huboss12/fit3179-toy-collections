{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Violin plot of minimum recommended age by LEGO theme group",
  "title": {
    "text": "Some LEGO isn't aimed at children at all",
    "subtitle": ["Distribution of the minimum recommended age, by theme group, for sets released since 2000. Dots mark the median.", "Violin width shows the shape of each group's age range, not how many sets it contains. Source: Brickset"],
    "anchor": "start",
    "fontSize": 16,
    "subtitleFontSize": 11,
    "subtitleColor": "#555"
  },
  "data": {"url": "data/lego_sets.csv", "format": {"parse": {"year": "number", "agerange_min": "number"}}},
  "transform": [
    {"filter": "datum.agerange_min != null && datum.agerange_min >= 1 && datum.agerange_min <= 18"},
    {"filter": "datum.year >= 2000"},
    {"filter": "indexof(['Pre-school','Basic','Modern day','Licensed','Action/Adventure','Model making','Technical'], datum.themeGroup) >= 0"}
  ],
  "facet": {
    "column": {
      "field": "themeGroup",
      "type": "nominal",
      "title": null,
      "sort": ["Pre-school", "Basic", "Modern day", "Licensed", "Action/Adventure", "Model making", "Technical"],
      "header": {"labelOrient": "bottom", "labelPadding": 6, "labelAngle": -35, "labelAlign": "right", "labelFontSize": 10}
    }
  },
  "spacing": 4,
  "resolve": {"scale": {"x": "independent"}},
  "spec": {
    "width": 72,
    "height": 300,
    "layer": [
      {
        "transform": [{"density": "agerange_min", "groupby": ["themeGroup"], "extent": [0, 22], "steps": 80, "as": ["age", "density"]}],
        "mark": {"type": "area", "orient": "horizontal", "fillOpacity": 0.9, "stroke": "white", "strokeWidth": 0.6},
        "encoding": {
          "y": {
            "field": "age",
            "type": "quantitative",
            "title": "Minimum recommended age",
            "scale": {"domain": [0, 22]},
            "axis": {"values": [2, 4, 6, 8, 10, 12, 14, 16, 18], "grid": true, "gridColor": "#eee", "labelFontSize": 11}
          },
          "x": {"field": "density", "type": "quantitative", "stack": "center", "impute": null, "title": null, "axis": null},
          "color": {
            "field": "themeGroup",
            "type": "nominal",
            "legend": null,
            "scale": {
              "domain": ["Pre-school", "Basic", "Modern day", "Licensed", "Action/Adventure", "Model making", "Technical"],
              "range": ["#fee8c8", "#fdd7b0", "#fdc086", "#fdae6b", "#f16913", "#d94801", "#a63603"]
            }
          },
          "tooltip": [
            {"field": "themeGroup", "type": "nominal", "title": "Theme group"},
            {"field": "age", "type": "quantitative", "title": "Age", "format": ".0f"}
          ]
        }
      },
      {
        "transform": [{"aggregate": [{"op": "median", "field": "agerange_min", "as": "med"}, {"op": "count", "as": "n"}]}],
        "mark": {"type": "point", "filled": true, "size": 55, "color": "#5c1a00"},
        "encoding": {
          "y": {"field": "med", "type": "quantitative"},
          "tooltip": [
            {"field": "med", "type": "quantitative", "title": "Median age"},
            {"field": "n", "type": "quantitative", "title": "Sets"}
          ]
        }
      },
      {
        "transform": [{"aggregate": [{"op": "median", "field": "agerange_min", "as": "med"}]}],
        "mark": {"type": "text", "fontSize": 9, "fontWeight": "bold", "color": "#5c1a00", "dx": 14},
        "encoding": {
          "y": {"field": "med", "type": "quantitative"},
          "text": {"field": "med", "type": "quantitative", "format": ".0f"}
        }
      },
      {
        "transform": [{"filter": "datum.themeGroup == 'Technical'"}, {"aggregate": [{"op": "count", "as": "c"}]}],
        "mark": {"type": "text", "align": "center", "fontSize": 9, "color": "#333", "lineBreak": "|", "lineHeight": 10, "dy": 4},
        "encoding": {
          "y": {"datum": 19.3, "type": "quantitative"},
          "x": {"value": 36},
          "text": {"value": "18+ sets:|adults only"}
        }
      }
    ]
  },
  "config": {"view": {"stroke": null}}
}