{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 780,
  "height": 420,
  "title": {
    "text": "Almost every toy Australia buys crosses one ocean",
    "subtitle": "Toy imports by source country, 2025. Arcs sized by value; sources above US$2m shown. Source: UN Comtrade via WITS",
    "anchor": "start",
    "fontSize": 16,
    "subtitleFontSize": 11
  },
  "projection": {"type": "naturalEarth1", "rotate": [-120, 0, 0]},
  "layer": [
    {
      "data": {"url": "data/world-110m.json", "format": {"type": "topojson", "feature": "countries"}},
      "mark": {"type": "geoshape", "fill": "#ebebe7", "stroke": "#ffffff", "strokeWidth": 0.5}
    },
    {
      "data": {
        "url": "data/aus_imports.csv",
        "format": {"parse": {"Year": "number", "TradeValue in 1000 USD": "number"}}
      },
      "transform": [
        {"filter": "datum.Year == 2025"},
        {"filter": "datum.PartnerISO3 != 'WLD' && datum.PartnerISO3 != 'AUS'"},
        {"calculate": "datum['TradeValue in 1000 USD'] / 1000", "as": "value_m"},
        {"filter": "datum.value_m >= 2"},
        {
          "lookup": "PartnerISO3",
          "from": {
            "data": {
              "url": "data/country_lookup.csv",
              "format": {"parse": {"lon": "number", "lat": "number"}}
            },
            "key": "code",
            "fields": ["lon", "lat", "name"]
          }
        },
        {"calculate": "134.376", "as": "auLon"},
        {"calculate": "-25.561", "as": "auLat"}
      ],
      "mark": {"type": "rule", "color": "#a63603", "opacity": 0.55, "strokeCap": "round"},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "longitude2": {"field": "auLon"},
        "latitude2": {"field": "auLat"},
        "strokeWidth": {
          "field": "value_m",
          "type": "quantitative",
          "scale": {"type": "sqrt", "range": [0.8, 14]},
          "legend": {"title": "Imports (US$m)", "orient": "bottom-left", "titleFontSize": 11, "labelFontSize": 10}
        },
        "tooltip": [
          {"field": "name", "type": "nominal", "title": "From"},
          {"field": "value_m", "type": "quantitative", "title": "US$ million", "format": ",.0f"}
        ]
      }
    },
    {
      "data": {"values": [{"lon": 134.376, "lat": -25.561}]},
      "mark": {"type": "point", "filled": true, "size": 90, "color": "#5c1a00"},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"}
      }
    }
  ]
}