{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 780,
  "height": 420,
  "title": {
    "text": "Almost every toy Australia buys crosses one ocean",
    "subtitle": "Toy imports by source country, 2025. Arcs sized by value; sources above US$2m shown. Source: UN Comtrade via WITS",
    "anchor": "start",
    "fontSize": 16,
    "subtitleFontSize": 11
  },
  "projection": {
    "type": "naturalEarth1",
    "rotate": [
      -120,
      0,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.id != 10"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#ebebe7",
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/aus_imports.csv",
        "format": {
          "parse": {
            "Year": "number",
            "TradeValue in 1000 USD": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.Year == 2025"
        },
        {
          "filter": "datum.PartnerISO3 != 'WLD' && datum.PartnerISO3 != 'AUS'"
        },
        {
          "calculate": "datum['TradeValue in 1000 USD'] / 1000",
          "as": "value_m"
        },
        {
          "filter": "datum.value_m >= 2"
        },
        {
          "lookup": "PartnerISO3",
          "from": {
            "data": {
              "url": "data/country_lookup.csv",
              "format": {
                "parse": {
                  "lon": "number",
                  "lat": "number"
                }
              }
            },
            "key": "code",
            "fields": [
              "lon",
              "lat",
              "name"
            ]
          }
        },
        {
          "calculate": "134.376",
          "as": "auLon"
        },
        {
          "calculate": "-25.561",
          "as": "auLat"
        },
        {
          "calculate": "toNumber(datum.lon) < -60 ? toNumber(datum.lon) + 360 : toNumber(datum.lon)",
          "as": "lon0"
        },
        {
          "calculate": "datum.PartnerISO3 == 'CHN' ? 0.2 : indexof(['VNM','THA','IND','BGD','IDN'], datum.PartnerISO3) >= 0 ? -0.25 : datum.lon0 < 60 ? -0.36 : 0.32",
          "as": "bend"
        },
        {
          "calculate": "(datum.lon0 + datum.auLon) / 2 - (datum.auLat - toNumber(datum.lat)) * datum.bend",
          "as": "cLon"
        },
        {
          "calculate": "(toNumber(datum.lat) + datum.auLat) / 2 + (datum.auLon - datum.lon0) * datum.bend",
          "as": "cLat"
        },
        {
          "calculate": "1 - 9 / sqrt(pow(datum.auLon - datum.lon0, 2) + pow(datum.auLat - toNumber(datum.lat), 2))",
          "as": "tEnd"
        },
        {
          "calculate": "sequence(0, 1.001, 0.02)",
          "as": "ts"
        },
        {
          "flatten": [
            "ts"
          ],
          "as": [
            "t"
          ]
        },
        {
          "filter": "datum.t <= datum.tEnd"
        },
        {
          "calculate": "pow(1-datum.t,2)*datum.lon0 + 2*(1-datum.t)*datum.t*datum.cLon + pow(datum.t,2)*datum.auLon",
          "as": "pLon"
        },
        {
          "calculate": "pow(1-datum.t,2)*toNumber(datum.lat) + 2*(1-datum.t)*datum.t*datum.cLat + pow(datum.t,2)*datum.auLat",
          "as": "pLat"
        }
      ],
      "layer": [
        {
          "transform": [
            {
              "filter": "datum.PartnerISO3 != 'CHN'"
            }
          ],
          "mark": {
            "type": "line",
            "color": "#a63603",
            "opacity": 0.001,
            "strokeWidth": 10,
            "strokeCap": "round",
            "interpolate": "linear",
            "cursor": "pointer"
          },
          "encoding": {
            "longitude": {
              "field": "pLon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "pLat",
              "type": "quantitative"
            },
            "detail": {
              "field": "PartnerISO3"
            },
            "order": {
              "field": "t",
              "type": "quantitative"
            },
            "tooltip": [
              {
                "field": "name",
                "type": "nominal",
                "title": "From"
              },
              {
                "field": "value_m",
                "type": "quantitative",
                "title": "US$ million",
                "format": ",.0f"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.PartnerISO3 == 'CHN'"
            }
          ],
          "mark": {
            "type": "line",
            "color": "#a63603",
            "opacity": 0.45,
            "strokeCap": "round",
            "interpolate": "linear",
            "cursor": "pointer"
          },
          "encoding": {
            "longitude": {
              "field": "pLon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "pLat",
              "type": "quantitative"
            },
            "detail": {
              "field": "PartnerISO3"
            },
            "order": {
              "field": "t",
              "type": "quantitative"
            },
            "strokeWidth": {
              "field": "value_m",
              "type": "quantitative",
              "scale": {
                "type": "sqrt",
                "range": [
                  0.8,
                  14
                ]
              },
              "legend": {
                "title": "Imports (US$m)",
                "orient": "bottom-left",
                "direction": "horizontal",
                "symbolType": "stroke",
                "values": [
                  10,
                  100,
                  500,
                  1000
                ],
                "titleFontSize": 11,
                "labelFontSize": 10
              }
            },
            "tooltip": [
              {
                "field": "name",
                "type": "nominal",
                "title": "From"
              },
              {
                "field": "value_m",
                "type": "quantitative",
                "title": "US$ million",
                "format": ",.0f"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.PartnerISO3 != 'CHN'"
            }
          ],
          "mark": {
            "type": "line",
            "color": "#a63603",
            "opacity": 0.7,
            "strokeCap": "round",
            "interpolate": "linear",
            "cursor": "pointer"
          },
          "encoding": {
            "longitude": {
              "field": "pLon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "pLat",
              "type": "quantitative"
            },
            "detail": {
              "field": "PartnerISO3"
            },
            "order": {
              "field": "t",
              "type": "quantitative"
            },
            "strokeWidth": {
              "field": "value_m",
              "type": "quantitative",
              "scale": {
                "type": "sqrt",
                "range": [
                  0.8,
                  14
                ]
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "name",
                "type": "nominal",
                "title": "From"
              },
              {
                "field": "value_m",
                "type": "quantitative",
                "title": "US$ million",
                "format": ",.0f"
              }
            ]
          }
        }
      ]
    },
