{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 720,
  "height": 340,
  "title": {
    "text": "Behind China, the suppliers keep changing",
    "subtitle": "Australia's toy imports excluding China, by source country, 1995–2025. Source: UN Comtrade via WITS",
    "anchor": "start",
    "fontSize": 16,
    "subtitleFontSize": 11
  },
  "data": {
    "url": "data/aus_imports.csv",
    "format": {"parse": {"Year": "number", "TradeValue in 1000 USD": "number"}}
  },
  "transform": [
    {"filter": "datum.PartnerISO3 != 'WLD' && datum.PartnerISO3 != 'CHN'"},
    {"calculate": "datum['TradeValue in 1000 USD'] / 1000", "as": "value_m"},
    {"calculate": "datum.PartnerName == 'Other Asia, nes' ? 'Taiwan' : datum.PartnerName == 'Hong Kong, China' ? 'Hong Kong' : datum.PartnerName == 'Czech Republic' ? 'Czechia' : datum.PartnerName", "as": "country"},
    {"calculate": "indexof(['Vietnam','Denmark','United States','Hong Kong','Taiwan','Indonesia','Thailand','Czechia','Germany'], datum.country) >= 0 ? datum.country : 'All others'", "as": "src"},
    {"aggregate": [{"op": "sum", "field": "value_m", "as": "m"}], "groupby": ["Year", "src"]}
  ],
  "layer": [
    {
    "mark": {"type": "area", "interpolate": "monotone", "stroke": "white", "strokeWidth": 0.4},
    "encoding": {
    "x": {
      "field": "Year",
      "type": "quantitative",
      "title": null,
      "scale": {"domain": [1995, 2025], "nice": false},
      "axis": {"format": "d", "grid": false, "domain": false, "tickCount": 7, "labelFontSize": 11}
    },
    "y": {"field": "m", "type": "quantitative", "stack": "center", "title": null, "axis": null},
    "color": {
      "field": "src",
      "type": "nominal",
      "title": "Source",
      "scale": {
        "domain": ["Vietnam", "Indonesia", "Thailand", "Denmark", "Czechia", "Hong Kong", "Taiwan", "United States", "Germany", "All others"],
        "range": ["#1d9e75", "#b45cb0", "#e8a33d", "#185fa5", "#6baed6", "#8c6bb1", "#9ecae1", "#c9a227", "#bdbdbd", "#d9d9d9"]
      },
      "legend": {"orient": "right", "labelFontSize": 10, "symbolType": "square", "titleFontSize": 11}
    },
    "tooltip": [
      {"field": "src", "type": "nominal", "title": "Source"},
      {"field": "Year", "type": "quantitative", "format": "d"},
      {"field": "m", "type": "quantitative", "title": "US$ million", "format": ",.0f"}
        ]
    }
    },
            {
      "data": {"values": [
        {"x": 2013, "y": 190, "x2": 2007, "y2": 300, "t": "Denmark and Czechia peak|— LEGO's European plants"},
        {"x": 2022, "y": 211, "x2": 2019, "y2": 330, "t": "Vietnam arrives|from nothing"}
      ]},
      "mark": {"type": "rule", "color": "#666", "strokeWidth": 0.8},
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "y": {"field": "y", "type": "quantitative"},
        "x2": {"field": "x2"},
        "y2": {"field": "y2"}
      }
    },
    {
      "data": {"values": [
        {"x2": 2007, "y2": 300, "t": "Denmark and Czechia peak|— LEGO's European plants"},
        {"x2": 2019, "y2": 330, "t": "Vietnam arrives|from nothing"}
      ]},
      "mark": {"type": "text", "fontSize": 10.5, "fontWeight": "bold", "lineBreak": "|", "color": "#222", "align": "center", "dy": -12, "lineHeight": 13},
      "encoding": {
        "x": {"field": "x2", "type": "quantitative"},
        "y": {"field": "y2", "type": "quantitative"},
        "text": {"field": "t"}
      }
    }
  ]
}