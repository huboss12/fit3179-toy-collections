{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 400,
  "title": {
    "text": "China makes most of the world's toys",
    "subtitle": "Toy exports by country, 2024 (HS 9503). Source: UN Comtrade via WITS",
    "anchor": "start",
    "fontSize": 16,
    "subtitleFontSize": 11
  },
  "projection": {"type": "equalEarth"},
  "layer": [
    {
      "data": {"sphere": true},
      "mark": {"type": "geoshape", "fill": "#eaf2f5"}
    },
    {
      "data": {
        "url": "data/world-110m.json",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "mark": {"type": "geoshape", "fill": "#e8e8e4", "stroke": "#ffffff", "strokeWidth": 0.5}
    },
    {
      "data": {"url": "data/world_exports.csv"},
      "transform": [
        {"filter": "datum.Year == 2024"},
        {"filter": "datum.ReporterISO3 != 'EUN'"},
        {"calculate": "datum['TradeValue in 1000 USD'] / 1000", "as": "value_m"},
        {"calculate": "datum.value_m < 10 ? 'Under $10m' : datum.value_m < 100 ? '$10m–$100m' : datum.value_m < 500 ? '$100m–$500m' : datum.value_m < 2000 ? '$500m–$2bn' : datum.value_m < 10000 ? '$2bn–$10bn' : 'Over $10bn'", "as": "band"},
        {
          "lookup": "ReporterISO3",
          "from": {
            "data": {"url": "data/country_lookup.csv"},
            "key": "code",
            "fields": ["id", "name"]
          }
        },
        {
          "lookup": "id",
          "from": {
            "data": {
              "url": "data/world-110m.json",
              "format": {"type": "topojson", "feature": "countries"}
            },
            "key": "id"
          },
          "as": "geo"
        }
      ],
      "mark": {"type": "geoshape", "stroke": "#ffffff", "strokeWidth": 0.5},
      "encoding": {
        "shape": {"field": "geo", "type": "geojson"},
        "color": {
            "field": "band",
            "type": "ordinal",
            "title": "Toy exports (US$)",
            "scale": {
                "domain": ["Under $10m", "$10m–$100m", "$100m–$500m", "$500m–$2bn", "$2bn–$10bn", "Over $10bn"],
                "range": ["#fee8c8", "#fdd0a2", "#fdae6b", "#e6550d", "#a63603", "#5c1a00"]
            },
            "legend": {
                "orient": "bottom-left",
                "direction": "horizontal",
                "symbolType": "square",
                "symbolSize": 200,
                "columns": 6,
                "labelFontSize": 10,
                "titleFontSize": 11,
                "offset": 60
            }
            },
        "tooltip": [
          {"field": "name", "type": "nominal", "title": "Country"},
          {"field": "value_m", "type": "quantitative", "title": "US$ million", "format": ",.0f"}
        ]
      }
    },
    {
      "data": {"values": [{"lon": 103.9, "lat": 36.6}]},
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 35,
        "dy": -55,
        "fontSize": 11,
        "fontWeight": "bold",
        "lineHeight": 13,
        "text": ["China: US$39.9bn", "64% of world exports"]
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"}
      }
    }
  ]
}