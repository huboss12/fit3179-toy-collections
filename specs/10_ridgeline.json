{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Ridgeline plot of LEGO set piece counts by decade, with medians marked",
  "title": {
    "text": "LEGO sets have quadrupled in size since the 1980s",
    "subtitle": ["Distribution of pieces per set, by decade, with the median marked. Log scale.", "Source: Brickset"],
    "anchor": "start",
    "fontSize": 16,
    "subtitleFontSize": 11,
    "subtitleColor": "#555"
  },
  "data": {"url": "data/lego_sets.csv", "format": {"parse": {"year": "number", "pieces": "number"}}},
  "transform": [
    {"filter": "datum.pieces != null && datum.pieces > 0"},
    {"calculate": "floor(datum.year / 10) * 10", "as": "decade"},
    {"calculate": "log(datum.pieces) / log(10)", "as": "lp"}
  ],
  "facet": {
    "row": {
      "field": "decade",
      "type": "ordinal",
      "title": null,
      "header": {"labelAngle": 0, "labelAlign": "left", "labelFontSize": 11, "labelFontWeight": "bold", "labelExpr": "datum.value + 's'"}
    }
  },
  "spec": {
    "width": 560,
    "height": 42,
    "layer": [
      {
        "transform": [
          {"density": "lp", "groupby": ["decade"], "extent": [0, 4], "steps": 120, "as": ["value", "density"]},
          {"calculate": "pow(10, datum.value)", "as": "pieces_at"}
        ],
        "mark": {"type": "area", "interpolate": "monotone", "fillOpacity": 0.85, "stroke": "white", "strokeWidth": 0.8},
        "encoding": {
          "x": {
            "field": "value",
            "type": "quantitative",
            "title": "Pieces per set",
            "axis": {"values": [0, 1, 2, 3, 4], "labelExpr": "pow(10, datum.value)", "grid": true, "gridColor": "#eee", "labelFontSize": 11}
          },
          "y": {"field": "density", "type": "quantitative", "axis": null, "scale": {"domain": [0, 1.15], "range": [40, -40]}},
          "fill": {"field": "decade", "type": "ordinal", "legend": null, "scale": {"scheme": "oranges"}},
          "tooltip": [
            {"field": "decade", "type": "ordinal", "title": "Decade"},
            {"field": "pieces_at", "type": "quantitative", "title": "Pieces", "format": ".0f"}
          ]
        }
      },
      {
        "transform": [{"aggregate": [{"op": "median", "field": "lp", "as": "medlp"}, {"op": "median", "field": "pieces", "as": "medp"}]}],
        "mark": {"type": "rule", "strokeWidth": 1.4, "color": "#5c1a00", "opacity": 0.9},
        "encoding": {
          "x": {"field": "medlp", "type": "quantitative"},
          "y": {"value": 40},
          "y2": {"value": 12},
          "tooltip": [{"field": "medp", "type": "quantitative", "title": "Median pieces", "format": ".0f"}]
        }
      },
      {
        "transform": [{"aggregate": [{"op": "median", "field": "lp", "as": "medlp"}, {"op": "median", "field": "pieces", "as": "medp"}]}],
        "mark": {"type": "text", "align": "center", "dy": -4, "fontSize": 9, "fontWeight": "bold", "color": "#5c1a00"},
        "encoding": {
          "x": {"field": "medlp", "type": "quantitative"},
          "y": {"value": 12},
          "text": {"field": "medp", "type": "quantitative", "format": ".0f"}
        }
      },
      {
        "transform": [{"filter": "datum.decade == 2010"}, {"aggregate": [{"op": "count", "as": "c"}]}],
        "mark": {"type": "text", "align": "center", "fontSize": 9, "color": "#444", "lineBreak": "|", "lineHeight": 10},
        "encoding": {
          "x": {"datum": 0.78, "type": "quantitative"},
          "y": {"value": 5},
          "text": {"value": "Polybags and|promo minis"}
        }
      },
      {
        "transform": [{"filter": "datum.decade == 2020"}, {"aggregate": [{"op": "count", "as": "c"}]}],
        "mark": {"type": "text", "align": "center", "fontSize": 9, "color": "#444", "lineBreak": "|", "lineHeight": 10},
        "encoding": {
          "x": {"datum": 3.55, "type": "quantitative"},
          "y": {"value": 6},
          "text": {"value": "Largest set:|11,695 pieces"}
        }
      }
    ]
  },
  "bounds": "flush",
  "spacing": 0,
  "config": {"view": {"stroke": null}}
}